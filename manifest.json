{
    "manifest_version": 3,
    "name": "Hide Github Inline Annotations",
    "version": "1.0",
    "description": "Hides Github elements with class tr.js-inline-annotations",
    "permissions": [
        "scripting",
        "activeTab"
    ],
    "action": {
        "default_title": "Hide Github Inline Annotations",
        "default_icon": {
            "16": "icons/icon-off.png",
            "48": "icons/icon-off.png",
            "128": "icons/icon-off.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "128": "icons/icon-on.png"
    },
    "host_permissions": [
        "https://github.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://github.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "icons/icon-on.png"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}