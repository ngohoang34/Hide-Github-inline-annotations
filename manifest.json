{
    "manifest_version": 3,
    "name": "Hide Github Inline Annotations",
    "version": "1.0",
    "description": "Hides Github elements with class tr.js-inline-annotations",
    "permissions": [
        "scripting",
        "activeTab"
    ],
    "action": {
        "default_title": "Hide Github Inline Annotations"
    },
    "background": {
        "service_worker": "background.js"
    }
}